# ===== Global Environment Variables =====
TZ=your_time_zone
PUID=1000
PGID=1000
# LinuxServer images read UMASK. A name with a _SET suffix is ignored.
UMASK=002

# ===== Jellyfin =====
JELLYFIN_PublishedServerUrl=jellyfin.yourdomain.com

# ===== qBittorrent Exporter =====
# WebUI API key, created in qBittorrent 5.2.0 or later under Options, WebUI, API Key. See the README Monitoring section.
# Keep a non-empty value. If the variable is missing, the exporter falls back to the default login.
QBITTORRENT_API_KEY=your_qbittorrent_api_key
