# ===== Global Environment Variables =====
TZ=your_time_zone
PUID=1000
PGID=1000
# LinuxServer images read UMASK. A name with a _SET suffix is ignored.
UMASK=002

# ===== VPN / Gluetun Credentials =====
# ProtonVPN credentials (configuration is in the compose file)
# Append +pmp to the username to enable ProtonVPN port forwarding (gluetun wiki).
OPENVPN_USER=your_protonvpn_username
OPENVPN_PASSWORD=your_protonvpn_password

# ===== VPN Server Config =====
# Proton assigns a random forwarded port, so a static value here does not match it. See the README key variables section.
FIREWALL_VPN_INPUT_PORTS=53131
# Leave empty for no server filter. Otherwise use a hostname that appears in gluetun's server list.
# List the servers with: docker run --rm -v /yourpath:/gluetun qmcgaw/gluetun format-servers -protonvpn
# A hostname missing from that list stops gluetun from starting. node-be-75 is not in the current list.
SERVER_HOSTNAMES=

# ===== Jellyfin =====
JELLYFIN_PublishedServerUrl=jellyfin.yourdomain.com

# ===== qBittorrent Exporter =====
# WebUI API key, created in qBittorrent under Options, WebUI, API Key. See the README Monitoring section.
# Keep this line. If the variable is missing, the exporter falls back to the default login.
QBITTORRENT_API_KEY=your_qbittorrent_api_key
